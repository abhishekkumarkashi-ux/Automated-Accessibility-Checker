# AccessScan Server Configuration
PORT=3001
HOST=0.0.0.0

# Microsoft Foundry Agent Service Configuration (Optional)
# To enable the Accessibility Coach AI Agent, configure your Microsoft Foundry project details.
# If these variables are not set, AccessScan functions normally as an automated scanner,
# and displays a clear message stating AI guidance is not configured.

# The endpoint of your Microsoft Foundry (Azure AI Foundry) Project.
# Format example: https://<your-project>.<region>.api.azureml.ms/
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://your-project.region.api.azureml.ms/

# The deployed model name in your Microsoft Foundry project (e.g. gpt-4o, gpt-4o-mini).
AZURE_AI_FOUNDRY_MODEL_DEPLOYMENT=gpt-4o-mini

# Optional: Specific Agent ID if you wish to reuse an existing agent instead of dynamically creating one.
# AZURE_AI_FOUNDRY_AGENT_ID=

# Authentication:
# By default, DefaultAzureCredential is used (supports Azure CLI login, Managed Identity, or service principal).
# For Service Principal authentication, provide:
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
